# Data: fixture (sample data) or live. Production builds default to live.
CASEVEX_DATA_MODE=fixture
# demo (default) or pilot. Pilot refuses fixtures and demo sign-in, and is invite-only.
CASEVEX_DEPLOYMENT=demo

# Supabase Auth + database. Leave empty to use the demo sign-in (fixture mode only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show "Continue with Google" once Google is enabled in Supabase.
NEXT_PUBLIC_SUPABASE_GOOGLE=off
