# Copy to .env.local for local development. Never commit real keys.

# Data: fixture (sample data) or live. Production builds default to live.
# See docs/decisions/0003.
CASEVEX_DATA_MODE=fixture
# demo (default) or pilot. Pilot refuses fixtures and demo sign-in, and is invite-only.
CASEVEX_DEPLOYMENT=demo

# Supabase Auth + database. Leave empty to use the demo sign-in (fixture mode only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show "Continue with Google" once Google is enabled in Supabase.
NEXT_PUBLIC_SUPABASE_GOOGLE=off

# AI model routing (docs/ai/MODEL_ROUTING.md)
# Set either key, or both. OpenRouter serves every model; the Anthropic key
# serves Claude models only, called directly.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# auto (default) = OpenRouter when its key is set, otherwise Anthropic
# CASEVEX_AI_GATEWAY=auto
# CASEVEX_APP_URL=https://casevex.vercel.app
# CASEVEX_AI_OVERRIDES={"research.draft":"openai/gpt-6.1-sol"}
# CASEVEX_AI_EXPERIMENTS=1
# Firm-wide AI spend ceiling per UTC day, in USD (default 25). Research
# requests return 429 once a firm reaches it.
# CASEVEX_AI_DAILY_LIMIT_USD=25

# Worker only (never on Vercel): Supabase Storage S3 access key, so the
# worker can read uploaded documents. Storage only, no database access.
CASEVEX_WORKER_S3_ENDPOINT=
CASEVEX_WORKER_S3_REGION=
CASEVEX_WORKER_S3_KEY_ID=
CASEVEX_WORKER_S3_SECRET=
