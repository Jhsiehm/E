{
  "name": "casevex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "ai:report": "tsx scripts/ai-report.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "test:cross": "vitest run tests/shared tests/cross-module",
    "test:bias": "CASEVEX_BIAS_EVAL=1 node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/cross-module/fairness.test.ts",
    "test:db": "vitest run --no-file-parallelism tests/db tests/cross-module/access.test.ts",
    "worker": "tsx worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker.mjs --external:pg-native --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "pg": "^8.23.1",
    "postcss": "^8",
    "prettier": "^3.10.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
